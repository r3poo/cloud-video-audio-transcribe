# Copy this file to .env and fill in the key.
# The program reads .env from its own folder, then from the folder it is started in.

# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Picking a model in the dropdown saves it here, so the same model is
# used next time. Setting it by hand preselects it on start.
# OPENROUTER_MODEL=openai/whisper-large-v3

# Optional. ISO-639-1 hint for the language, e.g. en, de, es, pt.
# Leave empty to let the model detect the language.
# TRANSCRIBE_LANGUAGE=

# Optional. Target chunk length in seconds. Default 600, values below 30 are
# ignored. Shorter chunks mean more requests but recover better from a single
# failed upload.
# TRANSCRIBE_CHUNK_SECONDS=600

# Optional. Playback factor used when sending audio. Providers bill by audio
# second, so 2 sends the audio twice as fast and halves the cost. Allowed
# 0.5–4. Picking a speed in the app saves it here.
# TRANSCRIBE_SPEED=1

# Optional. Folder for the .srt and .txt results. Empty means "next to the
# source file".
# TRANSCRIBE_OUTPUT_DIR=
